# MFSAVANA Baileys Configuration
# Nomor telepon bot WhatsApp (hanya angka, tanpa tanda +, spasi, atau strip)
BOT_PHONE_NUMBER=

# Kode pairing default (default: MFSAVANA)
PAIRING_CODE=MFSAVANA

# Folder penyimpanan sesi auth
